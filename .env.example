# Local defaults. Copy this file to .env, then load it with:
# set -a; source .env; set +a
EXPERIMENTLENS_HOST=127.0.0.1
EXPERIMENTLENS_PORT=5050
EXPERIMENTLENS_WORKSPACE=.experimentlens/workspace
EXPERIMENTLENS_DATABASE_URL=sqlite:///.experimentlens/control-plane.db

# Agent limits. The deterministic offline gateway is used while OPENAI_API_KEY is empty.
OPENAI_API_KEY=
EXPERIMENTLENS_MODEL=gpt-5.6-luna
EXPERIMENTLENS_AGENT_MAX_STEPS=8
EXPERIMENTLENS_AGENT_TOKEN_BUDGET=8000
EXPERIMENTLENS_AGENT_TIMEOUT_SECONDS=60
EXPERIMENTLENS_AGENT_TOOL_TIMEOUT_SECONDS=10

# Optional evaluation isolation.
EXPERIMENTLENS_EVALUATION_WORKSPACE=.experimentlens/evaluation-workspace
EXPERIMENTLENS_EVALUATION_DATABASE_URL=sqlite:///.experimentlens/evaluation.db

# Optional OpenTelemetry exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
